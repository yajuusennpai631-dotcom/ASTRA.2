# ===== 必須 =====
# Discord Developer Portal > Bot > Token
DISCORD_BOT_TOKEN=

# ===== Dashboard（ウェブ管理画面 / Discord OAuth2ログイン）=====
# Developer Portal > OAuth2 > Client Secret
DISCORD_CLIENT_SECRET=
# 32文字以上のランダム文字列（Cookie署名用）
# 生成例: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# 公開URL。Developer Portal の Redirects に ${APP_URL}/auth/dashboard/callback を登録
APP_URL=
# 任意（未設定ならBotのIDを使用）
# DISCORD_CLIENT_ID=

# ===== 任意 =====
# Cloudflare Worker など外部から /internal/* を呼ぶ場合のみ。32文字以上推奨
# 生成例: python -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_API_SECRET=

# Railwayでは PORT が自動注入されるため通常は不要
# BOT_API_HOST=0.0.0.0
# BOT_API_PORT=8000
